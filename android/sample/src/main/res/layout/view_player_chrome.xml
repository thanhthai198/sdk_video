<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- YouTube mobile overlay -->
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_controls_vignette">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/minimizeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Minimize"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/autoplayButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Autoplay">

                <View
                    android:id="@+id/autoplayTrack"
                    android:layout_width="34dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:background="@drawable/autoplay_track_on" />

                <View
                    android:id="@+id/autoplayThumb"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:background="@drawable/autoplay_thumb" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/castButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cast"
                android:padding="8dp"
                android:src="@drawable/ic_cast"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/subtitleButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Subtitles"
                android:padding="8dp"
                android:src="@drawable/ic_cc"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Center transport -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previousButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:padding="12dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="#F2FFFFFF" />

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="28dp">

                <View
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/play_circle_bg" />

                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Play"
                    android:padding="18dp"
                    android:src="@drawable/ic_play"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:padding="12dp"
                android:src="@drawable/ic_skip_next"
                app:tint="#F2FFFFFF" />
        </LinearLayout>

        <!-- Bottom bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp">

            <SeekBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:max="1000"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="0"
                android:progressDrawable="@drawable/player_seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/player_seek_thumb"
                android:thumbOffset="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/time_pill_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="0:00 / 0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:text="0:01 / 2:11:36" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/fullscreenButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Fullscreen"
                    android:padding="8dp"
                    android:src="@drawable/ic_fullscreen"
                    app:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
